    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
