# Copy to .env.local for development. On the VPS this lives at .env.field,
# chmod 600, never in the repository (dok 08 §4, dok 09 §1).

# Signs the admin session cookie. Must be at least 32 bytes.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Seed credentials — consumed by scripts/seed-admin.js and seed-initial.js,
# never hardcoded and never committed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SHIFT_PASSWORD=

# Optional. Defaults to ./data/field.db, which is the mounted volume in Docker.
# DATABASE_PATH=./data/field.db

# GitHub release webhook — auto-publishes the APK from a release cut in
# sru-field-app (doc 09 §4). Unset means the route answers 503 and nothing is
# published automatically; the admin upload form still works either way.
# Must match the secret configured in the repo's webhook settings.
# Generate with: openssl rand -hex 32
APK_WEBHOOK_SECRET=

# Read-only PAT for downloading the release asset. Only needed while the app
# repo is private; on a public repo leave it unset and no auth is sent.
GITHUB_TOKEN=

# Only releases from this repository are accepted. Unset accepts any repo whose
# delivery carries a valid signature — set it.
APK_RELEASE_REPO=hfzndev/sru-field-app
